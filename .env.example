# Copy to .env (never commit .env). All values are optional.
PENMUNSHI_OLLAMA_URL=http://127.0.0.1:11434
PENMUNSHI_MODEL=gemma4:e4b
# seconds; first call can be slow while Ollama loads the model
PENMUNSHI_TIMEOUT=300
PENMUNSHI_NUM_CTX=8192
# screenshots are downscaled to this longest side before the vision pass
PENMUNSHI_MAX_IMAGE_SIDE=1600
# optional: path to a CISA KEV json (see scripts/update_kev.py)
# PENMUNSHI_KEV_PATH=data/kev.json
